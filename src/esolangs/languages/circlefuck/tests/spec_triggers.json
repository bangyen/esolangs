{
 "triggers": [
  {
   "program": "}",
   "stdin": "",
   "expect": "HaltError",
   "claim": "} deleting the last cell"
  },
  {
   "program": "\\",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "a trailing backslash escape"
  },
  {
   "program": " ",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "an empty program"
  },
  {
   "program": "\\256",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "three decimal digits past 255"
  },
  {
   "program": ",.@",
   "stdin": "",
   "expect": "output",
   "output": ",",
   "claim": ", at EOF is a no-op"
  }
 ]
}
