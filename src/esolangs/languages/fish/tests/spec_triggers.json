{
 "triggers": [
  {
   "program": "z;",
   "stdin": "",
   "expect": "HaltError",
   "claim": "an invalid instruction is a HaltError"
  },
  {
   "program": "10,;",
   "stdin": "",
   "expect": "HaltError",
   "claim": "division by zero is a HaltError"
  },
  {
   "program": "~;",
   "stdin": "",
   "expect": "HaltError",
   "claim": "stack underflow is a HaltError"
  },
  {
   "program": "",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "an empty program is a ProgramError"
  },
  {
   "program": "in;",
   "stdin": "",
   "expect": "output",
   "output": "-1",
   "claim": "i pushes -1 at EOF and the run goes on"
  }
 ]
}
