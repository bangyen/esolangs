{
 "triggers": [
  {
   "program": "a::=:::\n::=\na",
   "stdin": "",
   "expect": "InputExhaustedError",
   "claim": "InputExhaustedError: a ::: rule with no input left"
  },
  {
   "program": "foo\n::=\nx",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "ProgramError: a rule line without ::="
  },
  {
   "program": "::=b\n::=\nx",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "ProgramError: a rule with an empty left-hand side"
  },
  {
   "program": "a::=b\nx",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "ProgramError: no separator line"
  }
 ]
}
