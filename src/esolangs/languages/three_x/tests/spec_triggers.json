{
 "triggers": [
  {
   "program": "333x33x",
   "stdin": "",
   "expect": "HaltError",
   "claim": "HaltError: division by zero"
  },
  {
   "program": "3)",
   "stdin": "",
   "expect": "HaltError",
   "claim": "HaltError: stray )"
  },
  {
   "program": "!",
   "stdin": "",
   "expect": "HaltError",
   "claim": "HaltError: underflow"
  },
  {
   "program": "3(",
   "stdin": "",
   "expect": "HaltError",
   "claim": "HaltError: unmatched ("
  },
  {
   "program": "?",
   "stdin": "",
   "expect": "InputExhaustedError",
   "claim": "InputExhaustedError: ? at EOF"
  },
  {
   "program": "?",
   "stdin": "abc",
   "expect": "ProgramError",
   "claim": "ProgramError: ? reads anything but an integer or fraction"
  },
  {
   "program": "[abc",
   "stdin": "",
   "expect": "output",
   "output": "",
   "claim": "[ with no ] prints nothing"
  }
 ]
}
