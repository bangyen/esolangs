{
 "triggers": [
  {
   "program": "inc(1)",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "malformed compact-notation line."
  },
  {
   "program": "~",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "~ with no jump number."
  },
  {
   "program": "+",
   "stdin": "",
   "expect": "output",
   "output": "1 0",
   "claim": "Both registers print once at the end, space-separated, no trailing newline."
  },
  {
   "program": "~\n0",
   "stdin": "",
   "expect": "output",
   "output": "0 0",
   "claim": "Jump number 0 names no command: that ~ falls through."
  }
 ]
}
