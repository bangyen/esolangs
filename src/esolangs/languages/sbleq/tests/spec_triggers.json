{
 "triggers": [
  {
   "program": "1000000000000000000 0 0",
   "stdin": "",
   "expect": "InterpreterLimitError",
   "claim": "InterpreterLimitError: a store past the cell limit."
  },
  {
   "program": "0 0 -1",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "ProgramError: a negative c."
  },
  {
   "program": "x",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "ProgramError: a non-integer program token."
  },
  {
   "program": "-4 0 0",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "ProgramError: an address below -3."
  },
  {
   "program": "-3 -2 0",
   "stdin": "",
   "expect": "output",
   "output": "\u0000",
   "claim": "-2 reads zero at EOF; -3 prints the other operand."
  }
 ]
}
