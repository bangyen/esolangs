{
 "triggers": [
  {
   "program": "x",
   "stdin": "",
   "expect": "HaltError",
   "claim": "HaltError: an unknown command"
  },
  {
   "program": "~",
   "stdin": "",
   "expect": "HaltError",
   "claim": "HaltError: stack underflow"
  },
  {
   "program": "(a",
   "stdin": "",
   "expect": "HaltError",
   "claim": "HaltError: unbalanced parentheses"
  },
  {
   "program": "(a)S",
   "stdin": "",
   "expect": "output",
   "output": "a",
   "claim": "S outputs the top string"
  }
 ]
}
