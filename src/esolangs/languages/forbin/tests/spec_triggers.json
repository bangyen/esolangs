{
 "triggers": [
  {
   "program": "f { return 0; }\nmain {\n for i:0..f { f 0; }\n}\n",
   "stdin": "",
   "expect": "HaltError",
   "claim": "a for bound that is not a number is a HaltError"
  },
  {
   "program": "main { x = 0; r = (x 1); }",
   "stdin": "",
   "expect": "HaltError",
   "claim": "calling a value that is not a function is a HaltError"
  },
  {
   "program": "main { out 0,1,0; }",
   "stdin": "",
   "expect": "HaltError",
   "claim": "out without exactly eight bit arguments is a HaltError"
  },
  {
   "program": "main { a,b,c,d,e,f,g,h = (in 0); }",
   "stdin": "",
   "expect": "InputExhaustedError",
   "claim": "in raises at EOF"
  },
  {
   "program": "main {",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "malformed syntax is a ProgramError"
  },
  {
   "program": "f { return 0; }",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "no main function is a ProgramError"
  }
 ]
}
