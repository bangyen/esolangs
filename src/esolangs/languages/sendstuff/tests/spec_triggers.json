  {"program": ">x", "stdin": "", "expect": "ProgramError", "claim": "a reference to a node not yet opened"},
  {"program": ">r(InputNumber >(Multiply 2 >(OutputNumber)) >r)", "stdin": "x", "expect": "ArgumentError", "claim": "an InputNumber token that is not an integer"},
  {"program": ">r(InputNumber >(Multiply 2 >(OutputNumber)) >r)", "stdin": "-3", "expect": "HaltError", "claim": "a negative InputNumber"},
  {"program": ">(Constant 1114112 >(Output))", "stdin": "", "expect": "HaltError", "claim": "Output of a code above 1114111"},
  {"program": ">r(InputNumber >(Multiply 2 >(OutputNumber)) >r)", "stdin": "21 4\n", "expect": "output", "output": "428", "claim": "InputNumber sends nothing at EOF"}
 ]
