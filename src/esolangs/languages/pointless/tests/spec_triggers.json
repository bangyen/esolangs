  {"program": ",", "stdin": "", "expect": "InputExhaustedError", "claim": ", at EOF"},
  {"program": "<", "stdin": "", "expect": "HaltError", "claim": "moving left of cell 0"},
  {"program": "!>!", "stdin": "", "expect": "HaltError", "claim": "a second !"}
 ]
