{
 "triggers": [
  {
   "program": "-ww ( ! )",
   "stdin": "",
   "expect": "InputExhaustedError",
   "claim": "InputExhaustedError: a backwards ! at EOF."
  },
  {
   "program": ".w",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "ProgramError: a colour pair that is not two colours."
  },
  {
   "program": "x",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "ProgramError: an unknown token."
  },
  {
   "program": ")",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "ProgramError: an unmatched parenthesis (close)."
  },
  {
   "program": "(",
   "stdin": "",
   "expect": "ProgramError",
   "claim": "ProgramError: an unmatched parenthesis (open)."
  },
  {
   "program": "-ww ( ! )",
   "stdin": "AAAAAAAA",
   "expect": "output",
   "output": "",
   "claim": "Positive control (8 passes, 8 reads): a backwards ! reads a character without printing."
  }
 ]
