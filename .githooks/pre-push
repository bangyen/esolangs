#!/bin/sh
# Pre-push hook: run scripts/verify.py before allowing a push.  Enabled
# automatically by `just install-dev` (git config core.hooksPath .githooks),
# or manually with:
#
#     git config core.hooksPath .githooks
#
# The script runs the local-checkable subset of the CI workflow (lint,
# pytest, bandit, the Python-only verify scripts) so failures are
# caught before pushing rather than in GitHub Actions.
#
# verify.py scopes itself to the files the branch touched, so a push that
# moved one interpreter does not re-prove the other twelve cross-checks.  It
# widens back to the full stack whenever the diff cannot be read or shared
# machinery moved, and CI still runs everything on every push regardless.
# The differential corpora are left to CI entirely (which runs them twice,
# with --fuzz 50).  Set VERIFY_FULL=1 to force the complete stack locally.
#
# Branch deletions are exempt.  Git runs this hook for every push, including
# `git push --delete`, but a deletion sends no commits, so there is nothing
# for the checks to validate -- running the suite there only makes a cleanup
# operation slow enough to invite --no-verify, which would skip the checks on
# real pushes too.  Git feeds each ref being pushed to stdin as
#
#     <local-ref> <local-sha> <remote-ref> <remote-sha>
#
# and uses the all-zero sha for the local side of a deletion, so a push whose
# refs are *all* deletions can be waved through.  A mixed push (some deletes,
# some updates) still runs the checks.
deleting_only=1
saw_ref=0

while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "$local_sha" ] && continue
    saw_ref=1
    case "$local_sha" in
        *[!0]*) deleting_only=0 ;;
    esac
done

if [ "$saw_ref" -eq 1 ] && [ "$deleting_only" -eq 1 ]; then
    echo "pre-push: deletion only, skipping local checks"
    exit 0
fi

# Check the tree being pushed, not the one holding the hook.  With
# core.hooksPath set, git runs *this* file for every worktree of the repo,
# so `dirname "$0"` points at the main checkout even when the push comes
# from a worktree -- and verify.py derives its ROOT (the venv it picks and
# the PYTHONPATH it exports) from its own location.  Resolving the script
# through the top level of the working tree git is pushing keeps the checks
# pointed at the commits actually being sent; otherwise a worktree push
# validates the main checkout's files instead, which fails as soon as the
# two trees differ.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || ROOT=""
[ -n "$ROOT" ] || ROOT="$(dirname "$0")/.."
# Say so before handing off.  Starting python, importing, and working out the
# scope all happen before verify.py's first line of output, and a push that
# prints nothing at all looks like a push that has wedged rather than one that
# is working.  Naming the escape hatch here is the point: the checks take a
# couple of minutes on a branch that moved the shared machinery, and a user
# who cannot see why reaches for --no-verify, which skips them entirely.
echo "pre-push: running scripts/verify.py (a couple of minutes; --no-verify skips it)"

# verify.py picks the project interpreter itself (.venv, then uv run), so
# the hook can hand it any python that can execute the file.
if [ -n "$VERIFY_FULL" ] && [ "$VERIFY_FULL" != "0" ]; then
    exec "${PY:-python3}" "$ROOT/scripts/verify.py" --full
fi
exec "${PY:-python3}" "$ROOT/scripts/verify.py"
