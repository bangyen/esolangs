#!/bin/sh
# Pre-push hook: run scripts/verify/gate.py before allowing a push.  Enabled
# automatically by `just install-dev` (git config core.hooksPath .githooks),
# or manually with:
#
#     git config core.hooksPath .githooks
#
# The script runs the local-checkable subset of the CI workflow (lint,
# pytest, the Python-only verify scripts) so failures are
# caught before pushing rather than in GitHub Actions.
#
# gate.py scopes itself to the files the branch touched, so a push that
# moved one interpreter does not re-prove the other twelve cross-checks.  It
# widens back to the full stack whenever the diff cannot be read or shared
# machinery moved, and CI still runs everything on every push regardless.
# Set VERIFY_FULL=1 to force the complete stack locally.
#
# Branch deletions are exempt.  Git runs this hook for every push, including
# `git push --delete`, but a deletion sends no commits, so there is nothing
# for the checks to validate -- running the suite there only makes a cleanup
# operation slow enough to invite --no-verify, which would skip the checks on
# real pushes too.  Git feeds each ref being pushed to stdin as
#
#     <local-ref> <local-sha> <remote-ref> <remote-sha>
#
# and uses the all-zero sha for the local side of a deletion, so a push whose
# refs are *all* deletions can be waved through.  A mixed push (some deletes,
# some updates) still runs the checks.
fail() {
    printf 'pre-push: %s\n' "$1" >&2
    exit 1
}

refs="$(cat)" || fail "could not read the refs to push"
head=""
saw_ref=0

while read -r local_ref local_sha _remote_ref _remote_sha; do
    [ -z "$local_sha" ] && continue
    saw_ref=1
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac
    if [ -z "$head" ]; then
        # The shared hook can live outside the worktree being pushed.
        ROOT="$(git rev-parse --show-toplevel)" || fail "could not locate the checkout"
        head="$(git -C "$ROOT" rev-parse --verify HEAD)" || fail "could not read HEAD"
    fi
    target="$(git -C "$ROOT" rev-parse --verify --end-of-options "${local_sha}^{commit}")" ||
        fail "$local_ref does not name a verifiable commit"
    [ "$target" = "$head" ] ||
        fail "$local_ref names $target, but HEAD is $head. Check out the commit being pushed."
done <<EOF
$refs
EOF

if [ -z "$head" ]; then
    if [ "$saw_ref" -eq 1 ]; then
        echo "pre-push: deletion only, skipping local checks"
    fi
    exit 0
fi

check_checkout() {
    current="$(git -C "$ROOT" rev-parse --verify HEAD)" || fail "could not read HEAD"
    [ "$current" = "$head" ] || fail "HEAD moved from $head to $current during verification"
    status="$(git -C "$ROOT" status --porcelain=v1 --untracked-files=all --ignore-submodules=none)" ||
        fail "could not check checkout status"
    [ -z "$status" ] || fail "use a clean checkout of $head to verify the push"
}

check_checkout
# Say so before handing off.  Starting python, importing, and working out the
# scope all happen before gate.py's first line of output, and a push that
# prints nothing at all looks like a push that has wedged rather than one that
# is working.  Naming the escape hatch here is the point: the checks take up
# to three minutes on a branch that moved the shared machinery (173 s on
# 2026-10-11), and a user who cannot see why reaches for
# --no-verify, which skips them entirely.
#
# gate.py prints one line per step and replays the output of the ones that
# failed.  `just test --verbose` streams every step's output live instead; it
# is a wall of text, which is why the hook does not ask for it.
echo "pre-push: running scripts/verify/gate.py (up to 3 min; --no-verify skips it)"

# The gate runs checks through uv; this interpreter only launches it.
if [ -n "$VERIFY_FULL" ] && [ "$VERIFY_FULL" != "0" ]; then
    "${PY:-python3}" "$ROOT/scripts/verify/gate.py" --full || exit "$?"
else
    "${PY:-python3}" "$ROOT/scripts/verify/gate.py" || exit "$?"
fi
check_checkout
